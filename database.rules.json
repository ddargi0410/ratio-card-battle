{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/ownerUid').val() == auth.uid && newData.child('meta/expiresAt').val() > now) || (data.child('meta/ownerUid').val() == auth.uid && data.child('meta/expiresAt').val() > now))",
        ".validate": "$code.matches(/^[0-9]{8}$/) && newData.hasChild('meta')",
        "meta": {
          ".read": "auth != null && (!data.exists() || data.child('expiresAt').val() > now)",
          ".validate": "newData.hasChildren(['ownerUid','status','createdAt','expiresAt','duration','startRound','shop','steal'])",
          "ownerUid": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() == auth.uid) || newData.val() == data.val())"
          },
          "status": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() == 'lobby') || (data.val() == 'lobby' && (newData.val() == 'lobby' || newData.val() == 'playing' || newData.val() == 'ended')) || (data.val() == 'playing' && (newData.val() == 'playing' || newData.val() == 'ended')) || (data.val() == 'ended' && newData.val() == 'ended'))"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == now) || newData.val() == data.val())"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() > now && newData.val() <= now + 86400000) || newData.val() == data.val())"
          },
          "duration": {
            ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1440"
          },
          "startRound": {
            ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 100"
          },
          "shop": {
            ".validate": "newData.isBoolean()"
          },
          "steal": {
            ".validate": "newData.isBoolean() && (newData.val() == false || newData.parent().child('shop').val() == true)"
          },
          "$other": {
            ".validate": "false"
          },
          "startedAt": {
            ".validate": "newData.isNumber() && (newData.val() == data.val() || (newData.val() >= now - 60000 && newData.val() <= now + 60000))"
          },
          "endedAt": {
            ".validate": "newData.isNumber() && (newData.val() == data.val() || (newData.val() >= now - 60000 && newData.val() <= now + 60000))"
          },
          "endsAt": {
            ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() == data.val() || (newData.val() >= newData.parent().child('startedAt').val() && newData.val() <= newData.parent().child('expiresAt').val()))"
          }
        },
        "players": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && newData.exists() && (( !data.exists() && (root.child('rooms').child($code).child('meta').child('status').val() == 'lobby' || root.child('rooms').child($code).child('meta').child('status').val() == 'playing')) || data.exists())",
            ".validate": "newData.hasChildren(['name','score','round','ok','ng','guard','joinedAt','online']) && (data.exists() || (newData.child('score').val() == 0 && newData.child('round').val() == root.child('rooms').child($code).child('meta').child('startRound').val() && newData.child('ok').val() == 0 && newData.child('ng').val() == 0 && newData.child('guard').val() == 0 && newData.child('online').val() == true && !newData.hasChild('rp') && !newData.hasChild('done') && !newData.hasChild('fxD') && !newData.hasChild('fxS') && !newData.hasChild('hitAt'))) && ((auth != null && root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid) || newData.child('hitAt').val() == data.child('hitAt').val()) && (!data.exists() || (auth != null && root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid) || root.child('rooms').child($code).child('meta').child('status').val() == 'playing' || (newData.child('score').val() == data.child('score').val() && newData.child('round').val() == data.child('round').val() && newData.child('ok').val() == data.child('ok').val() && newData.child('ng').val() == data.child('ng').val() && newData.child('guard').val() == data.child('guard').val() && newData.child('rp').val() == data.child('rp').val() && newData.child('done').val() == data.child('done').val() && newData.child('fxD').val() == data.child('fxD').val() && newData.child('fxS').val() == data.child('fxS').val()))",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= -1000000 && newData.val() <= 1000000"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 1 && newData.val() <= 100"
            },
            "ok": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "ng": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "guard": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1"
            },
            "rp": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 15"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == now) || newData.val() == data.val())"
            },
            "$other": {
              ".validate": "false"
            },
            "fxD": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('rooms').child($code).child('meta').child('expiresAt').val()"
            },
            "fxS": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('rooms').child($code).child('meta').child('expiresAt').val()"
            },
            "hitAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= root.child('rooms').child($code).child('meta').child('expiresAt').val() && ((auth != null && root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid) || newData.val() == data.val())"
            },
            ".read": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now"
          }
        },
        "requests": {
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists()) && auth.uid == $uid",
            ".write": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists()) && auth.uid == $uid && (!newData.exists() || (!data.exists() && root.child('rooms').child($code).child('meta').child('status').val() == 'playing' && root.child('rooms').child($code).child('meta').child('steal').val() == true && root.child('rooms').child($code).child('players').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['id','target','createdAt']) && newData.child('target').val() != $uid && (data.exists() || root.child('rooms').child($code).child('players').child(newData.child('target').val()).exists())",
            "id": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/)"
            },
            "target": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())"
            },
            "$other": {
              ".validate": "false"
            }
          }
        },
        "feed": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists())",
          "$event": {
            ".validate": "newData.hasChildren(['type','from','to','t'])",
            "type": {
              ".validate": "newData.val() == 'stolen' || newData.val() == 'blocked'"
            },
            "from": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "t": {
              ".validate": "newData.isNumber() && (newData.val() == data.val() || (newData.val() >= now - 60000 && newData.val() <= now + 60000))"
            },
            "$other": {
              ".validate": "false"
            },
            "to": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            }
          }
        },
        "inbox": {
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists()) && auth.uid == $uid",
            "$event": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists()) && auth.uid == $uid && !newData.exists()",
              ".validate": "newData.hasChildren(['type','from','t'])",
              "type": {
                ".validate": "newData.val() == 'stolen' || newData.val() == 'blocked'"
              },
              "from": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "t": {
                ".validate": "newData.isNumber() && (newData.val() == data.val() || (newData.val() >= now - 60000 && newData.val() <= now + 60000))"
              },
              "$other": {
                ".validate": "false"
              },
              "to": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
              }
            }
          }
        },
        "results": {
          "$uid": {
            ".read": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists()) && auth.uid == $uid",
            "$requestId": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('expiresAt').val() > now && (root.child('rooms').child($code).child('meta').child('ownerUid').val() == auth.uid || root.child('rooms').child($code).child('players').child(auth.uid).exists()) && auth.uid == $uid && !newData.exists()",
              ".validate": "newData.hasChildren(['outcome','amount','tname'])",
              "outcome": {
                ".validate": "newData.val() == 'stolen' || newData.val() == 'blocked' || newData.val() == 'immune' || newData.val() == 'empty' || newData.val() == 'gone' || newData.val() == 'error' || newData.val() == 'insufficient' || newData.val() == 'unavailable' || newData.val() == 'expired' || newData.val() == 'funds'"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() % 1 == 0 && newData.val() >= 0 && newData.val() <= 1000000"
              },
              "tname": {
                ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 8"
              },
              "$other": {
                ".validate": "false"
              }
            }
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}
